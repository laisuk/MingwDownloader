#include <windows.h>

101 ICON "app.ico"

#define VER_FILEVERSION             1,0,1,0
#define VER_FILEVERSION_STR         "1.0.1.0\0"
#define VER_PRODUCTVERSION          1,0,1,0
#define VER_PRODUCTVERSION_STR      "1.0.1.0\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Laisuk Lai\0"
            VALUE "FileDescription",  "MingwDownloader\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "MingwDownloader.exe\0"
            VALUE "OriginalFilename", "MingwDownloader.exe\0"
            VALUE "ProductName",      "MingwDownloader\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            VALUE "LegalCopyright",   "© 2026 Laisuk Lai\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END